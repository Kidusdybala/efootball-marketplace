PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/aurashop-marketplace

JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# ---- Telegram ----
# Get bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstUvWxYz12345678

# Bot username WITHOUT the @ (e.g. AuraShopBot) — used for fallback deep-links
TELEGRAM_BOT_USERNAME=YourBotUsername

# Public channel username (starts with @) OR numeric channel ID.
# IMPORTANT: Add your bot to this channel as an ADMIN with
# "Edit messages of others" permission so the bot can mark posts SOLD.
TELEGRAM_CHANNEL_ID=@AuraShopCatalog

# ADMIN_CHAT_ID: The single Telegram user ID (numeric) of the admin.
# This is where:
#   - New pending listings are sent for approval/rejection
#   - Payment receipts + credentials are relayed during escrow
#   - The "RELEASE" button appears once BOTH are in
# Get yours from @userinfobot or @myidbot
ADMIN_CHAT_ID=1890482340

ADMIN_TELEGRAM_IDS=5356565604,1890482340,THIRD_ADMIN_ID_HERE

# PAYMENT_INSTRUCTIONS: JSON array of bank objects shown as selectable buttons in the BUY flow.
# Each object: {"name":"Bank Name","account":"123456","holder":"Account Holder"}
# Example:
# PAYMENT_INSTRUCTIONS=[{"name":"CBE","account":"1000648228736","holder":"MURAD GENA"},{"name":"Telebirr","account":"0909844959","holder":"MURAD GENA"}]

SERVICE_FEE_RATE=0.1

# ---- Security ----
# AES-256-GCM key for encrypting account credentials in the DB.
# Use at least 32 characters. BACK THIS UP. If you lose it,
# all stored credentials become unrecoverable.
ENCRYPTION_KEY=my32byteOrLongerEncryptionKeyForCreds!!!

# ---- URLs ----
APP_URL=http://localhost:3000
API_URL=http://localhost:5000/api
